pipeline {
  agent {
    docker {
      image 'arunsubbu8467/maven-java17-docker'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  environment {
    SONAR_URL = "http://44.204.26.152:9000"
    DOCKER_IMAGE_NAME = "tharindumycloud/ultimate-cicd"
    GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
    GIT_USER_NAME = "Tharindu-GH"
  }

  stages {

    stage('Checkout') {
      steps {
            script {
              echo "Checking out the repository"
              sh 'git --version'
              sh 'ls -al'
        }
        }
      }


    stage('Build and Test') {
      steps {
        dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {
          sh 'mvn clean package'
        }
      }
    }

    stage('Static Code Analysis') {
        environment {
            SONAR_URL = "http://44.204.26.152:9000"
        }
        steps {
            withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
              dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') { // Make sure you run the SonarQube command from the right directory
                sh '''
                  mvn sonar:sonar \
                    -Dsonar.login=$SONAR_AUTH_TOKEN \
                    -Dsonar.host.url=$SONAR_URL
                 '''
              }
          }
      }
    }

    stage('Build and Push Docker Image') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'docker-cred',
          usernameVariable: 'DOCKER_USER',
          passwordVariable: 'DOCKER_PASS'
        )]) {
          dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') {  // Ensure Docker build is executed from the correct directory
            sh '''
              docker build -t ${DOCKER_IMAGE_NAME}:${BUILD_NUMBER} .
              echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
              docker push ${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}
            '''
          }
        }
      }
    }

    stage('Update Deployment File') {
      steps {
          withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                // Navigate to the directory where the Git repo is located
                dir('java-maven-sonar-argocd-helm-k8s/spring-boot-app') { 
                  script {
                    // Ensure Git is initialized in this directory
                    sh 'git status'
                    sh 'git config user.email "tharindu.mycloud@gmail.com"'
                    sh 'git config user.name "Tharindu-GH"'
          
                    // Update the deployment file using the correct path
                    sh '''
                      # Update the deployment image tag
                      sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" ../spring-boot-app-manifests/deployment.yml
                      
                      # Add, commit, and push changes to GitHub
                      git add ../spring-boot-app-manifests/deployment.yml
                      git commit -m "Update deployment image to ${BUILD_NUMBER}" || echo "No changes"
                      git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git main
                    '''
                  }
                }
              }
        }
    }

  }
}
